{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo \"Static marketing site ready\"",
  "installCommand": "echo \"No dependencies to install\"",
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/workspace",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0"},
        {"key": "CDN-Cache-Control", "value": "no-store"},
        {"key": "Vercel-CDN-Cache-Control", "value": "no-store"}
      ]
    },
    {
      "source": "/workspace/:path*",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0"},
        {"key": "CDN-Cache-Control", "value": "no-store"},
        {"key": "Vercel-CDN-Cache-Control", "value": "no-store"}
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.propsintell.com/api/:path*"
    },
    {
      "source": "/player-images/:path*",
      "destination": "https://api.propsintell.com/player-images/:path*"
    },
    {
      "source": "/player-image-proxy",
      "destination": "https://api.propsintell.com/player-image-proxy"
    },
    {
      "source": "/workspace",
      "destination": "https://prop-intelligence.vercel.app/"
    },
    {
      "source": "/workspace/",
      "destination": "https://prop-intelligence.vercel.app/"
    },
    {
      "source": "/workspace/:path*",
      "destination": "https://prop-intelligence.vercel.app/:path*"
    },
    {
      "source": "/login",
      "destination": "/"
    },
    {
      "source": "/signup",
      "destination": "/"
    },
    {
      "source": "/account",
      "destination": "https://prop-intelligence.vercel.app/"
    },
    {
      "source": "/auth/callback",
      "destination": "https://prop-intelligence.vercel.app/"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.propsintell.com"
        }
      ],
      "destination": "https://pipropsintell.com/workspace",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "app.propsintell.com"
        }
      ],
      "destination": "https://pipropsintell.com/workspace/:path*",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "/workspace",
      "permanent": true
    },
    {
      "source": "/install",
      "destination": "/#install",
      "permanent": false
    }
  ]
}
