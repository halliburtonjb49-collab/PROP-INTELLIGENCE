{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo \"Static marketing site ready\"",
  "installCommand": "echo \"No dependencies to install\"",
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/app",
      "destination": "https://app.propsintell.com",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "https://app.propsintell.com",
      "permanent": false
    },
    {
      "source": "/signup",
      "destination": "https://app.propsintell.com",
      "permanent": false
    }
  ]
}
