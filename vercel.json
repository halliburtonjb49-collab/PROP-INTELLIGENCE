{
  "buildCommand": "bash vercel_build.sh",
  "outputDirectory": "build/site",
  "installCommand": "echo 'Skip install - Flutter handles dependencies'",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.propsintell.com/api/:path*"
    },
    {
      "source": "/player-images/:path*",
      "destination": "https://api.propsintell.com/player-images/:path*"
    },
    {
      "source": "/player-image-proxy",
      "destination": "https://api.propsintell.com/player-image-proxy"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/signup",
      "destination": "/index.html"
    },
    {
      "source": "/account",
      "destination": "/workspace/index.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/workspace/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/workspace",
      "destination": "/workspace/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(self)"},
        {"key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains"}
      ]
    },
    {
      "source": "/workspace/assets/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=300, must-revalidate"}
      ]
    },
    {
      "source": "/workspace/(index.html|flutter_bootstrap.js|flutter_service_worker.js|manifest.json|OneSignalSDKWorker.js|pwa_install.js|offline.html)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0"},
        {"key": "CDN-Cache-Control", "value": "no-store"},
        {"key": "Vercel-CDN-Cache-Control", "value": "no-store"}
      ]
    },
    {
      "source": "/workspace/main.dart.js",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0"},
        {"key": "CDN-Cache-Control", "value": "no-store"},
        {"key": "Vercel-CDN-Cache-Control", "value": "no-store"}
      ]
    },
    {
      "source": "/(index.html|auth-modal.js)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0"},
        {"key": "CDN-Cache-Control", "value": "no-store"},
        {"key": "Vercel-CDN-Cache-Control", "value": "no-store"}
      ]
    }
  ],
  "env": {
    "API_BASE_URL": "https://pipropsintell.com",
    "SUPABASE_URL": "https://doncoxjilytojmnpukxi.supabase.co",
    "AUTH_EMAIL_REDIRECT_URL": "https://pipropsintell.com/workspace",
    "ALLOW_PUBLIC_SIGNUP": "true"
  }
}
