{
  "buildCommand": "bash vercel_build.sh",
  "outputDirectory": "build/web",
  "installCommand": "echo 'Skip install - Flutter handles dependencies'",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(self)"},
        {"key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains"}
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=300, must-revalidate"}
      ]
    },
    {
      "source": "/(index.html|flutter_bootstrap.js|flutter_service_worker.js|manifest.json|OneSignalSDKWorker.js|pwa_install.js|offline.html)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0"}
      ]
    },
    {
      "source": "/main.dart.js",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}
      ]
    }
  ],
  "env": {
    "API_BASE_URL": "https://api.propsintell.com",
    "SUPABASE_URL": "https://doncoxjilytojmnpukxi.supabase.co",
    "AUTH_EMAIL_REDIRECT_URL": "https://app.propsintell.com",
    "ALLOW_PUBLIC_SIGNUP": "true"
  }
}
